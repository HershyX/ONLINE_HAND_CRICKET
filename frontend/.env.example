# ─────────────────────────────────────────────────────────────────────────────
# Hand Cricket — Frontend Environment Variables
#
# HOW TO USE
# ──────────
# Local dev  : copy to .env.local — both vars can be left empty (Vite proxy handles routing).
# Vercel prod: add both vars in Vercel → Project → Settings → Environment Variables.
#              Re-deploy after saving.
#
# NEVER commit a .env.local that contains real URLs.
# ─────────────────────────────────────────────────────────────────────────────

# REST API base URL (include /api path suffix).
# Leave empty locally — Vite dev proxy forwards /api → http://localhost:8000.
# On Vercel: set to your full Render backend URL.
VITE_API_BASE_URL=https://YOUR-APP-NAME.onrender.com/api

# WebSocket base URL (wss:// in production, ws:// locally).
# Leave empty locally — auto-detected from browser origin.
# On Vercel: set to your full Render backend WS URL.
VITE_WS_BASE_URL=wss://YOUR-APP-NAME.onrender.com/ws
