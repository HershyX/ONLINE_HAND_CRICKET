# ─────────────────────────────────────────────────────────────────────────────
# Hand Cricket — Frontend Environment Configuration
# Copy this file to .env.local (git-ignored) for local overrides.
#
# VITE variables are embedded at build time — rebuild after changing.
# ─────────────────────────────────────────────────────────────────────────────

# Backend REST API base URL.
# Dev: proxied via Vite → use "/api" (default).
# Production: absolute URL to your backend.
# Example: https://api.handcricket.example.com/api
VITE_API_BASE_URL=/api

# WebSocket base URL.
# Dev: proxied via Vite → auto-detected from page origin (default).
# Production: auto-detected from page origin (ws/wss matches http/https).
# Only override if your WebSocket endpoint is on a different host.
# Example: wss://api.handcricket.example.com/ws
VITE_WS_BASE_URL=
