# ─────────────────────────────────────────────────────────────────────────────
# Hand Cricket — Backend Environment Configuration
# Copy this file to .env and fill in values for your deployment.
# The app loads .env automatically via python-dotenv.
# ─────────────────────────────────────────────────────────────────────────────

# Environment: "development" or "production"
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated list of allowed origins.
# In production, set CORS_ORIGINS to your deployed frontend URL(s).
# The localhost regex in main.py only applies in development mode.
CORS_ORIGINS=http://localhost:5173

# Frontend origin — set this in production to your exact frontend URL.
# Example: https://handcricket.example.com
FRONTEND_ORIGIN=

# Database — SQLite file path (relative to backend/ directory).
# In production, use an absolute path: sqlite+aiosqlite:////var/data/handcricket.db
DATABASE_URL=sqlite+aiosqlite:///./hand_cricket.db

# Logging — "debug", "info", "warning", "error"
LOG_LEVEL=info

# App
APP_VERSION=1.0.0
